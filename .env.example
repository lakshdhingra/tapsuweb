# Copy to .env.local and fill in from Supabase dashboard -> Project Settings -> API Keys
# NEXT_PUBLIC_* values are baked into the build, so they must be present when you build/deploy.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only - never expose. Set in production with: pnpm wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
